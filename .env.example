# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# GitHub (for repos requiring authenticated API access)
GITHUB_PAT=ghp_your_personal_access_token

# CryptoPanic — free API key from https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Pipeline Configuration
# PIPELINE_ENV: "dev" = Ollama (local, free) | "prod" = GPT-4.1 Mini (OpenAI, paid)
PIPELINE_ENV=dev
PIPELINE_VERSION=0.1.0
LOG_LEVEL=info
DRY_RUN=false
BATCH_SIZE=200
CONCURRENCY=1

# OpenAI — required when PIPELINE_ENV=prod
OPENAI_API_KEY=

# Ollama — used when PIPELINE_ENV=dev. Defaults shown; override OLLAMA_MODEL to
# summarize with a model you already have pulled instead of the 4.9 GB default.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Web App — PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Better Auth (self-hosted — #25). DATABASE_URL is the DIRECT Postgres connection,
# not the PostgREST URL: auth owns its own tables (user/session/account/verification)
# and needs real SQL for them. Everything else still goes through SUPABASE_URL.
#   Locally:    postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Production: the Supabase direct connection string.
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin Panel — comma-separated Better Auth user IDs that can access /admin
ADMIN_USER_IDS=

# Sentry Error Monitoring (optional — leave blank to disable)
# BOTH are needed for full coverage and they are not interchangeable: SENTRY_DSN
# initializes the server and edge runtimes and enables source-map upload at build
# time, while NEXT_PUBLIC_SENTRY_DSN is compiled into the browser bundle. Setting
# only the first means browser errors are still lost. Same DSN value in both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Fraction of requests traced, 0 to 1. Errors are always sent; only traces sample.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
